        <h2>Our Mission</h2>
        <p>To empower farmers with timely, localized and easy-to-follow recommendations that increase productivity and income while reducing losses and environmental impact.</p>
      </div>
    </section>

    <!-- SECTION 3: SERVICES (from left) -->
    <section class="about-section from-left" id="services">
      <div class="col-media" style="background-image: url('https://via.placeholder.com/900x600?text=Services+Image');"></div>
      <div class="col-body">
        <h2>What we provide</h2>

        <div class="services-list">
          <div class="service-card">
            <h4>Crop Advisory</h4>
            <p>Seasonal, location-specific recommendations: variety, sowing, spacing, irrigation.</p>
          </div>
          <div class="service-card">
            <h4>Fertilizer & Pesticide Guidance</h4>
            <p>Correct dosage, timing and safety steps to protect crops and farmers.</p>
          </div>
          <div class="service-card">
            <h4>Weather Alerts</h4>
            <p>Short-term forecasts and alerts with clear action points for field operations.</p>
          </div>
          <div class="service-card">
            <h4>Marketplace</h4>
            <p>Price signals & demand info to help sell at the right time and place.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION 4: VISION (from right) -->
    <section class="about-section from-right" id="vision">
      <div class="col-media" style="background-image: url('https://via.placeholder.com/900x600?text=Vision+Image');"></div>
